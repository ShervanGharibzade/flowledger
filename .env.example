# Copy to .env (or export as real env vars / secrets) for anything beyond
# local `dev` profile usage. Never commit a real .env file.

# Spring profile: dev or prod
SPRING_PROFILES_ACTIVE=dev

# --- Database (required for prod profile) ---
DB_URL=jdbc:postgresql://localhost:5432/flowledger
DB_USERNAME=flowledger
DB_PASSWORD=changeme

# --- Redis (required for prod profile) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT signing key (required for prod / any multi-instance deployment) ---
# PEM-encoded PKCS8 private key and X.509 public key, e.g. generated with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   openssl pkcs8 -topk8 -nocrypt -in private.pem -out private_pkcs8.pem
# Then paste the PEM contents (including the ----BEGIN/END---- lines) here.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Cookies / CORS ---
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
